# Polytrader Configuration
# Copy this file to .env and fill in your values

# Trading mode: paper | semi | auto
# - paper: No real trades, just logging
# - semi: Requires manual confirmation for each trade
# - auto: Fully automated trading
TRADING_MODE=paper

# Starting bankroll in USD
STARTING_BANKROLL=1500

# Polymarket credentials (required for live trading)
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=
POLYMARKET_API_KEY=

# Tomorrow.io API key (optional, 500 free calls/day)
TOMORROW_IO_API_KEY=

# Open-Meteo API key (optional, for paid plans with higher limits)
# Get a key at https://open-meteo.com/en/pricing
OPEN_METEO_API_KEY=

# Scan interval in seconds (how often to check markets)
# Default: 60 (once per minute). Lower = more API calls
SCAN_INTERVAL_SECONDS=60

# Risk parameters
MAX_POSITION_PCT=0.02
DAILY_LOSS_STOP_PCT=0.05
MAX_DRAWDOWN_PCT=0.20

# Edge threshold for trading
MIN_EDGE_THRESHOLD=0.10
MIN_MODEL_AGREEMENT=0.65

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
